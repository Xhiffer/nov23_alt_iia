# -----------------------------------------------------------------------------
# Example environment file — copy to `.env` and adjust per environment.
# NEVER commit the real `.env` (it is gitignored). Replace all default values
# below before any staging/production deployment.
# `docker-compose.yml` reads every secret from these variables.
# -----------------------------------------------------------------------------

# --- Main application database (PostgreSQL) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me
POSTGRES_DB=change_me

# --- PgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

# --- MinIO (S3-compatible artifact store) ---
MINIO_ROOT_USER=change_me
MINIO_ROOT_PASSWORD=change_me

# --- MLflow / S3 access (must match MinIO credentials above) ---
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=us-east-1

# --- Airflow metadata database ---
AIRFLOW_DB_USER=change_me
AIRFLOW_DB_PASSWORD=change_me
AIRFLOW_DB_NAME=airflow

# --- Airflow admin user + core settings ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Generate with:  openssl rand 32 | openssl base64 -A | tr '+/' '-_'
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=false

# --- ML thresholds ---
F1_PROMOTION_THRESHOLD=0.55
DRIFT_SHARE_THRESHOLD=0.3

# --- Alerting (drift) ---
# Webhook entrant compatible Slack/Mattermost/Discord. Laisser vide = pas d'alerte (no-op).
ALERT_WEBHOOK_URL=

# --- Lineage / provenance ---
# SHA du commit git injecté dans les runs MLflow. Vide -> "unknown".
# Lancer avec : GIT_COMMIT_SHA=$(git rev-parse HEAD) docker compose up -d app
GIT_COMMIT_SHA=
